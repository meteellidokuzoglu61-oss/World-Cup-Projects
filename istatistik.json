  "Paraguay": { "sira": 40, "form": "M-B-M-G-B", "yildiz": "Miguel Almirón", "analiz": "Sert savunma ve fiziksel oyun tercih ediyorlar." },
  "Katar": { "sira": 55, "form": "G-G-M-B-G", "yildiz": "Akram Afif", "analiz": "Asya şampiyonu kimliğiyle teknik kapasitesi yüksek bir takım." },
  "İsviçre": { "sira": 19, "form": "B-G-B-G-M", "yildiz": "Granit Xhaka", "analiz": "Savunma organizasyonu en sağlam takımlardan biri." },
  "Brezilya": { "sira": 6, "form": "G-G-G-G-B", "yildiz": "Vinícius Júnior", "analiz": "Turnuvanın doğal favorisi. Hücum hattı durdurulamaz." },
  "Fas": { "sira": 8, "form": "G-B-G-M-G", "yildiz": "Achraf Hakimi", "analiz": "Kuzey Afrika'nın en güçlü temsilcisi, savunmaları çok dirençli." },
  "Haiti": { "sira": 83, "form": "M-B-G-M-M", "yildiz": "Duckens Nazon", "analiz": "Turnuvanın zayıf halkalarından biri görülse de fiziksel dirençleri yüksek." },
  "İskoçya": { "sira": 43, "form": "M-B-B-G-M", "yildiz": "Scott McTominay", "analiz": "Orta saha mücadelesini seven, sert bir takım." },
  "Avustralya": { "sira": 27, "form": "G-G-B-M-G", "yildiz": "Harry Souttar", "analiz": "Hava toplarında çok etkililer, fiziksel oyun kuruyorlar." },
  "Türkiye": { "sira": 22, "form": "G-G-G-B-M", "yildiz": "Arda Güler", "analiz": "Genç ve yetenekli kadro. Orta saha yaratıcılığı üst düzey." },
  "Almanya": { "sira": 10, "form": "G-B-M-G-G", "yildiz": "Jamal Musiala", "analiz": "Turnuva takımı kimliğiyle disiplinli ve sonuç odaklılar." },
  "Curaçao": { "sira": 82, "form": "M-G-B-M-B", "yildiz": "Juninho Bacuna", "analiz": "Tarihlerinde ilk kez bu seviyedeler, kaybedecek bir şeyleri yok." },
  "Hollanda": { "sira": 7, "form": "G-G-B-G-M", "yildiz": "Xavi Simons", "analiz": "Taktiksel esnekliği yüksek, savunmadan oyun kurmada iyiler." },
  "Japonya": { "sira": 18, "form": "G-G-G-G-M", "yildiz": "Takefusa Kubo", "analiz": "Çok hızlı pas yapan ve disiplinden kopmayan bir ekip." },
  "Fildişi Sahili": { "sira": 34, "form": "G-G-B-M-G", "yildiz": "Sébastien Haller", "analiz": "Afrika şampiyonu, fiziksel güç ve teknik dengeye sahipler." },
  "Ekvador": { "sira": 23, "form": "G-B-G-M-B", "yildiz": "Enner Valencia", "analiz": "Güney Amerika'nın en dirençli takımlarından, kontra atakları tehlikeli." },
  "İsveç": { "sira": 38, "form": "G-B-G-G-M", "yildiz": "Alexander Isak", "analiz": "Modern futbolun tüm gerekliliklerini uygulayan dengeli bir takım." },
  "Tunus": { "sira": 44, "form": "B-M-G-B-M", "yildiz": "Elyas Skhiri", "analiz": "Savunma ağırlıklı ve rakibi bozan bir oyun tarzları var." },
  "İspanya": { "sira": 2, "form": "G-G-G-G-G", "yildiz": "Lamine Yamal", "analiz": "Topa sahip olma ve pas oyununda dünyanın en iyisi." },
  "Yeşil Burun Adaları": { "sira": 69, "form": "G-M-B-G-M", "yildiz": "Ryan Mendes", "analiz": "Bireysel yetenekleri yüksek, sürpriz yapabilecek bir takım." },
  "Belçika": { "sira": 9, "form": "G-B-G-M-G", "yildiz": "Kevin De Bruyne", "analiz": "Altın jenerasyonun son şansı, hücumda çok yaratıcılar." },
